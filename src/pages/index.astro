---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkThumb from '../components/WorkThumb.astro';
import portrait from '../assets/faria-portrait.jpg';
import {
  person, proof, about, work, openSource, principles, experience, toolkit, education, publication, certifications,
} from '../data/site';

// Experience: show this many achievements per role, the rest behind "show more".
const SHOWN = 3;
---

<Base
  title="Faria Nawer · Senior SQA Engineer"
  description="Faria Nawer builds the test automation that lets teams release with confidence: frameworks, API suites and release quality gates for fintech and enterprise systems."
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-name">
    <p class="status"><span class="dot" aria-hidden="true"></span>{person.status}</p>
    <p class="hero-hello">Hello, I'm</p>
    <h1 id="hero-name">{person.name}</h1>
    <p class="hero-lede">I build the test automation that lets teams release with <em>confidence</em>.</p>
    <p class="hero-sub">4.5+ years designing frameworks, API suites and release quality gates for fintech, banking-integration and enterprise HR platforms.</p>
    <ul class="socials">
      <li>
        <a class="icon-btn" href={person.linkedin} rel="me" aria-label="LinkedIn">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path></svg>
        </a>
      </li>
      <li>
        <a class="icon-btn" href={person.github} rel="me" aria-label="GitHub">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4 1.3-4-2-6-2.5M15 21v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.6-1.3 5.6-6A4.6 4.6 0 0 0 18.5 6a4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.6 2.5 5.6 2.8 5.6 2.8A4.3 4.3 0 0 0 5.5 6 4.6 4.6 0 0 0 4.2 9.3c0 4.6 2.9 5.7 5.6 6a3 3 0 0 0-.8 2.3V21"></path></svg>
        </a>
      </li>
      <li>
        <a class="icon-btn" href={`mailto:${person.email}`} aria-label="Email">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
        </a>
      </li>
    </ul>
    <div class="actions">
      <a class="btn btn-primary" href="#work">View work
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="btn btn-secondary" href={person.cv} target="_blank" rel="noopener" data-cv-link>View CV<span class="sr-only"> (opens in a new tab)</span>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"></path></svg>
      </a>
    </div>
  </section>

  <!-- Results -->
  <section class="container" aria-label="Results">
    <ul class="stats">
      {proof.map((p) => (
        <li class="stat">
          <p class="stat-num">{p.num}</p>
          <p class="stat-text">{p.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 01 About -->
  <section id="about" class="section container reveal" aria-labelledby="about-title">
    <div class="about">
      <figure class="about-photo">
        <Image
          class="portrait"
          src={portrait}
          alt="Portrait of Faria Nawer"
          widths={[260, 380, 760]}
          sizes="(max-width: 720px) 260px, 380px"
        />
      </figure>
      <div class="about-body">
        <p class="label">01 — About</p>
        <h2 id="about-title">Who stands behind the <em class="accent-em">tests</em>?</h2>
        {about.paragraphs.map((t) => <p>{t}</p>)}
        <ul class="domains">
          {about.domains.map((d) => (
            <li class="domain">
              <span class="domain-label">{d.label}</span>
              <span class="domain-text">{d.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 02 Selected work -->
  <section id="work" class="section container reveal" aria-labelledby="work-title">
    <SectionHeading
      id="work-title"
      label="02 — Selected work"
      title="Four problems, solved properly."
      note="Client details generalised. No proprietary code is shown."
    />
    <ul class="work-list">
      {work.map((w) => (
        <li class="work-card">
          <WorkThumb variant={w.thumb} />
          <div class="work-body">
            <p class="work-num">{w.num}{w.badge && ` · ${w.badge}`}</p>
            <h3 class="work-title"><a href={w.href}>{w.title}</a></h3>
            <ul class="chips" aria-label="Tools">{w.tags.map((t) => <li>{t}</li>)}</ul>
            <p class="work-summary">{w.summary}</p>
            <div class="work-actions">
              <a class="btn-ghost" href={w.href} aria-label={`Read case study: ${w.title}`}>Read case study →</a>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="oss">
      <p class="label">Open source</p>
      <ul class="oss-grid">
        {openSource.map((r) => (
          <li class="oss-card">
            <p class="oss-head"><span>{r.name}</span><span class="oss-badge">{r.status}</span></p>
            <p class="oss-text">{r.text}</p>
            <a class="btn-ghost" href={r.href} aria-label={`Source code: ${r.name}`}>Source code ↗</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 How I work -->
  <section id="approach" class="section container reveal" aria-labelledby="approach-title">
    <SectionHeading id="approach-title" label="03 — How I work" title="Four principles I test by." />
    <ol class="principles">
      {principles.map((p, i) => (
        <li class="principle">
          <span class="principle-num" aria-hidden="true">✓ {String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 04 Experience -->
  <section id="experience" class="section container reveal" aria-labelledby="xp-title">
    <SectionHeading id="xp-title" label="04 — Experience" title="From test cases to quality gates." />
    <ol class="timeline">
      {experience.map((x) => {
        const wins = x.achievements ?? [];
        const shown = wins.slice(0, SHOWN);
        const rest = wins.slice(SHOWN);
        return (
          <li class:list={['tl-item', { 'is-current': x.current }]}>
            <span class="tl-dot" aria-hidden="true"></span>
            <p class="tl-date">{x.date}</p>
            <p class="tl-role">{x.role}</p>
            <p class="tl-desc">{x.desc}</p>
            {shown.length > 0 && (
              <ul class="wins" aria-label={`Achievements: ${x.role}`}>
                {shown.map((a) => <li>{a}</li>)}
              </ul>
            )}
            {rest.length > 0 && (
              <details class="more">
                <summary>
                  <span class="more-open">+ {rest.length} more achievements</span>
                  <span class="more-close">Show fewer</span>
                </summary>
                <ul class="wins" aria-label={`More achievements: ${x.role}`}>
                  {rest.map((a) => <li>{a}</li>)}
                </ul>
              </details>
            )}
          </li>
        );
      })}
    </ol>
  </section>

  <!-- 05 Toolkit -->
  <section id="toolkit" class="section container reveal" aria-labelledby="tools-title">
    <SectionHeading id="tools-title" label="05 — Toolkit" title="Tools, grouped by the job they do." />
    <div class="tools">
      {toolkit.map((t) => (
        <div class="tool">
          <h3>{t.group}</h3>
          <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <!-- 06 Credentials -->
  <section id="credentials" class="section container reveal" aria-label="Education, publication and certifications">
    <div class="creds">
      <div class="cred-group">
        <h2 class="label">06 — Education</h2>
        {education.map((e) => (
          <div class="cred">
            <p class="cred-title">{e.title}</p>
            <p class="cred-sub">{e.sub}</p>
          </div>
        ))}
      </div>
      <div class="cred-group">
        <h2 class="label">Publication</h2>
        <div class="cred">
          <p class="cred-title serif">{publication.title}</p>
          <p class="cred-sub">{publication.sub}</p>
        </div>
      </div>
      <div class="cred-group">
        <h2 class="label">Certifications</h2>
        <ul class="cred-list">
          {certifications.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
