---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Faria Nawer" description="This page doesn't exist.">
  <section class="cs-head container">
    <p class="label">404 · 0 / 1 passed</p>
    <h1>This page didn't pass.</h1>
    <p class="cs-sub">The link may be old or mistyped. Everything else is still working.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to the homepage</a>
    </div>
  </section>
</Base>
